pkgname=entropy-player
pkgver=0.1.1
pkgrel=1
pkgdesc='Local music player with history-aware shuffle'
arch=('any')
url='https://github.com/luffy3006/entropy-player'
license=('unknown')
depends=('mpv' 'python' 'python-dbus-next' 'python-mutagen' 'python-mpv' 'python-pyqt6' 'python-textual' 'python-watchdog')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/luffy3006/entropy-player.git#branch=main")
sha256sums=('SKIP')

build() {
  cd "$srcdir/entropy-player"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/entropy-player"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/linux/entropy-player.desktop \
    "$pkgdir/usr/share/applications/entropy-player.desktop"
  install -Dm644 packaging/icons/entropy-player.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/entropy-player.svg"
}